{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markshot",
  "version": "0.1.0",
  "identifier": "com.admin.markshot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markshot",
        "width": 800,
        "height": 600,
        "decorations": false,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Pictures/Screenshots/**"]
      },
      "csp": null
    }
  }
}
